{
  "$schema": "./konnect.config.schema.json",
  "proxy": {
    "port": 1355
  },
  "contexts": {
    "ignore": ["context-name"]
  },
  "clusters": {
    "all": {
      "service": [
        {
          "name": "all-clusters-app",
          "namespace": "namespace",
          "target": "svc/service-name",
          "remote_port": 3000
        }
      ]
    },
    "usa-region": {
      "context": "arn:aws:eks:region:0123456789:cluster/cluster-name",
      "service": [
        {
          "name": "usa-app",
          "namespace": "namespace",
          "target": "svc/service-name",
          "remote_port": 3000
        },
        {
          "name": "usa-postgres",
          "namespace": "namespace",
          "target": "svc/postgres",
          "remote_port": 5432,
          "local_port": 15432
        }
      ]
    },
    "china-region": {
      "context": "arn:aws-cn:eks:region:0123456789:cluster/cluster-name",
      "service": [
        {
          "name": "china-app",
          "namespace": "namespace",
          "target": "svc/service-name",
          "remote_port": 3000
        },
        {
          "name": "china-postgres",
          "namespace": "namespace",
          "target": "svc/postgres",
          "remote_port": 5432,
          "local_port": 15433
        }
      ]
    }
  }
}
